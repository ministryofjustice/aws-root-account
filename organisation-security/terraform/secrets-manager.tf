# Wiz CSPM: connector External ID for the member-account StackSet.
# The value is generated by Wiz and populated out-of-band; no secret_version is
# managed here. It must match the management account's wiz_external_id when both
# belong to the same connector. The consuming data source is added behind
# wiz_enabled once the value exists.
resource "aws_secretsmanager_secret" "wiz_external_id" {
  name        = "wiz_external_id"
  description = "External ID generated by the Wiz AWS connector for the member-account Wiz StackSet"
  tags        = local.tags_organisation_management
}
